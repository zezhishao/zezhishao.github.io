{% assign is_chinese = false %}
{% if page.lang == 'zh-CN' %}{% assign is_chinese = true %}{% endif %}
{% assign home_url = '/en/' %}
{% if is_chinese %}{% assign home_url = '/' %}{% endif %}
<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != home_url %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="{% if is_chinese %}切换导航{% else %}Toggle navigation{% endif %}"
      >
        <span class="sr-only">
          {%- if is_chinese %}切换导航{% else %}Toggle navigation{% endif -%}
        </span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% for home_page in site.pages %}
            {% if home_page.permalink == home_url %} {% assign about_title = home_page.nav_title | default: home_page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == home_url %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {% if is_chinese %}首页{% else %}{{- about_title }}{% endif %}
              {% if page.permalink == home_url %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if is_chinese and p.permalink == '/people/' %}{% continue %}{% endif %}
            {% if p.nav and p.autogen == null %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == p.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {%- if is_chinese -%}
                      {%- assign nav_key = p.title | downcase | replace: ' ', '_' -%}
                      {{- site.data.locales.zh.zh[nav_key] | default: p.title -}}
                    {%- else -%}
                      {{- p.title -}}
                    {%- endif %}
                    {% if page.title == p.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                {% if is_chinese and p.language_alternate %}
                  {% assign parent_link = p.language_alternate %}
                {% endif %}
                <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif %}
                  {% if is_chinese and p.language_alternate %}
                    {% assign url = p.language_alternate %}
                  {% endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {%- if is_chinese -%}
                      {%- assign nav_key = p.title | downcase | replace: ' ', '_' -%}
                      {{- site.data.locales.zh.zh[nav_key] | default: p.title -}}
                    {%- else -%}
                      {{- p.title -}}
                    {%- endif %}
                    {% if page.url contains parent_link %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          <li class="nav-item">
            {% if is_chinese %}
              <a
                class="nav-link language-switch"
                href="{{ page.language_alternate | default: '/en/' | relative_url }}"
                lang="en"
                hreflang="en"
                aria-label="Switch to English"
                >English</a
              >
            {% else %}
              <a
                class="nav-link language-switch"
                href="{{ page.language_alternate | default: '/' | relative_url }}"
                lang="zh-CN"
                hreflang="zh-CN"
                aria-label="切换到中文页面"
                >中文</a
              >
            {% endif %}
          </li>
          {% if site.search_enabled and is_chinese == false %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
      {% if site.enable_darkmode %}
        {% include theme_toggle.liquid %}
      {% endif %}
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
