{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <input
    type="text"
    id="bibsearch"
    spellcheck="false"
    autocomplete="off"
    class="search bibsearch-form-input"
    placeholder="{% if page.lang == 'zh-CN' %}输入标题、作者或关键词筛选{% else %}Type to filter{% endif %}"
    aria-label="{% if page.lang == 'zh-CN' %}筛选论文{% else %}Filter publications{% endif %}"
  >
{% endif %}
